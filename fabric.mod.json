{
  "schemaVersion": 1,
  "id": "chunky_bot",
  "version": "${version}",
  "name": "Chunky Bot",
  "description": "Headless Fabric client bot for keeping a Minecraft server active for Chunky/world generation.",
  "authors": ["Shaurya"],
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.shaurya.chunkybot.ChunkyBotClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "1.21.11",
    "fabric-api": "*"
  }
}
